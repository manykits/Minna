#!/usr/bin/env node

/**
 * Module dependencies.
 */

require('dotenv').config();
var app = require('../app');
var debug = require('debug')('mthing:server');
var http = require('http');
var https = require('https');
var fs = require('fs');

var port = process.env.MINNA_PORT;
var portssl = process.env.MINNA_PORT_SSL;

app.set('port', port);
var server = http.createServer(app);
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// var privateKey  = fs.readFileSync('./plugins/activity/ssl/2_st.de123.com.key', 'utf8');
// var certificate = fs.readFileSync('./plugins/activity/ssl/1_st.de123.com_bundle.crt', 'utf8');
// var credentials = {key: privateKey, cert: certificate};
// var httpsServer = https.createServer(credentials, app);
// httpsServer.listen(portssl, function() {
//   console.log('HTTPS Server is running on: https://localhost:%s', portssl);
// });
// httpsServer.on('error', onErrorSSL);
// httpsServer.on('listening', onListeningSSL);

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}

function onErrorSSL(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof portssl === 'string'
    ? 'Pipe ' + portssl
    : 'Port ' + portssl;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListeningSSL() {
  var addr = httpsServer.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
